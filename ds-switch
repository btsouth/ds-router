#!/bin/sh
# ds-switch — point Hermes at the provider the router recommends.
#
# A thin wrapper: argument parsing and delegation to apply.py, which holds the
# logic and reads config.yaml. Deliberately POSIX sh with no arrays, because
# bash 3.2 (macOS default) has no associative arrays and this has to run there.
#
#   ds-switch              apply the router's current recommendation
#   ds-switch --show       print the recommendation without applying it
#   ds-switch --check      report whether the config can drive Hermes
#   ds-switch <provider>   pin a provider explicitly, ignoring the router
#   ds-switch --off        hand routing back to the default provider
#
# Turning it off is running --off, or not running it at all.

set -eu

# Resolve this script's own directory, following symlinks, so the wrapper works
# from anywhere (including a symlink on PATH).
self=$0
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *)  self=$(dirname "$self")/$link ;;
  esac
done
# pwd -P (physical) to match install.sh/uninstall.sh, which both resolve
# through symlinked directories the same way; otherwise the wrapper and the
# installed units would disagree about the project directory.
ROUTER_DIR=${DS_ROUTER_DIR:-$(cd "$(dirname "$self")" && pwd -P)}

if [ ! -f "$ROUTER_DIR/apply.py" ]; then
  echo "apply.py not found in $ROUTER_DIR" >&2
  exit 1
fi

case ${1:-} in
  -h|--help)
    # Print the leading comment block, stopping at the first line that is not a
    # comment. A hardcoded line range drifts when the header changes and can leak
    # implementation lines to the user.
    sed -n '2,/^[^#]/p' "$self" | sed '$d' | sed 's/^# \{0,1\}//'
    exit 0
    ;;
esac

# python3 is required; apply.py does the rest.
if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 is required but not on PATH" >&2
  exit 1
fi

exec python3 "$ROUTER_DIR/apply.py" "$@"
